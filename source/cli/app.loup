@mode(host.dual)

from appinfo import (EXIT_FOUND, EXIT_ERROR);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.findstr import (run_findstr);

# Parses argv, runs findstr and returns the exit status (findstr's
# ERRORLEVEL: 0 a line was printed, 1 none was, 2 a bad command line).
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(msg);
            return EXIT_ERROR;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_FOUND;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_FOUND;
    }

    try {
        return run_findstr(opts);
    } catch (Exception as e) {
        printErr("FINDSTR: " + e.message);
        return EXIT_ERROR;
    }
}
