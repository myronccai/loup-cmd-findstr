@mode(host.dual)

# Application identity for findstr: name, version, summary and the exit
# statuses (findstr's ERRORLEVELs). Keep APP_NAME and APP_VERSION in step
# with `name` and `version` in package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/findstr by `make
# build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "findstr";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Search files for strings and findstr regular expressions (a Loup recreation of the Windows findstr command).";

# Exit statuses returned by main() (findstr's ERRORLEVELs).
pub const EXIT_FOUND: int = 0;
pub const EXIT_NOT_FOUND: int = 1;
pub const EXIT_ERROR: int = 2;
