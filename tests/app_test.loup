@mode(host.dual)

# Unit tests for findstr's ERRORLEVELs over whole command lines
# (cli.app.run). These tests print the program's normal output and error
# messages.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with Stage0 (`loup-bootstrap test --no-parallel`, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary. The files it
# searches are created under build/tmp/ (removed by `make clean`).

from debug.assert import (expectEq);
from io.fs import (createDir, writeText, removeDir, isDir);
from appinfo import (EXIT_FOUND, EXIT_NOT_FOUND, EXIT_ERROR);
from cli.app import (run);

const ROOT: string = "build/tmp/findstr_app";

func test_version_and_help(): void {
    expectEq(run(["--version"]), EXIT_FOUND, "--version");
    expectEq(run(["/?"]), EXIT_FOUND, "/?");
}

func test_bad_command_line(): void {
    let none: list[string] = [];
    expectEq(run(none), EXIT_ERROR, "nothing");
    expectEq(run(["/N"]), EXIT_ERROR, "no strings");
    expectEq(run(["/R", "[x", "a.txt"]), EXIT_ERROR, "bad regex");
}

func test_found_and_not_found(): void {
    if (isDir(ROOT)) {
        removeDir(ROOT);
    }
    createDir(ROOT);
    writeText(ROOT + "/a.txt", "one\ntwo\n");
    writeText(ROOT + "/b.txt", "three\n");
    expectEq(run(["two", ROOT + "\\a.txt"]), EXIT_FOUND, "found");
    expectEq(run(["four", ROOT + "/a.txt"]), EXIT_NOT_FOUND, "not found");
    expectEq(run(["/V", "one two", ROOT + "/a.txt"]), EXIT_NOT_FOUND, "/V, every line matches");
    expectEq(run(["/M", "three", ROOT + "/*.txt"]), EXIT_FOUND, "wildcard");
    expectEq(run(["one", ROOT + "/missing.txt"]), EXIT_NOT_FOUND, "missing file");
    expectEq(run(["one", ROOT + "/missing.txt", ROOT + "/a.txt"]), EXIT_FOUND, "missing and found");
    expectEq(run(["/F:" + ROOT + "/none.txt", "x"]), EXIT_ERROR, "missing /F list");
    removeDir(ROOT);
}
